# GEMINI_API_KEY: Optional. Enables the owner-only "Verify Photo with Gemini" check
# in the Owner Studio. AI Studio injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# GEMINI_MODEL: Optional override for the photo-check model.
# GEMINI_MODEL="gemini-4-hydrogen"

# OWNER_CMS_TOKEN: Required to SAVE changes from the Owner Studio (at least 12
# characters, keep it secret). Without it the site works but the studio is read-only.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
OWNER_CMS_TOKEN=""

# SITE_URL: Public https origin of the live site (e.g. https://www.example.com).
# Used for the canonical link, social share image URLs, robots.txt and sitemap.xml.
# Falls back to APP_URL, then to the request's own host.
SITE_URL=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# CMS_DATA_FILE: Optional path for the persisted owner CMS state
# (default .casa-cms-state.json). Use persistent storage in production.
# CMS_DATA_FILE=".casa-cms-state.json"
